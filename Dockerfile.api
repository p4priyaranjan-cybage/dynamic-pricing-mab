FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Cache-bust: copy frontend separately so CSS/JS changes invalidate this layer
COPY frontend/ ./frontend/
COPY . .
# Ensure the data directory exists (shared via volume from bootstrap)
RUN mkdir -p /app/data
RUN chmod +x /app/scripts/wait-and-serve.sh
ENV DATABASE_URL=sqlite:////app/data/pricing.db
EXPOSE 8000
CMD ["/bin/bash", "/app/scripts/wait-and-serve.sh"]
